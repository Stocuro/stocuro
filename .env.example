# Stocuro — Docker Compose environment file.
#
# Copy this file to .env (same folder) and fill in the two password
# fields below with your own values before running `docker compose up`.
# See DOCKER.md for the full walkthrough. docker-compose.yml refuses to
# start the db service until STOCURO_DB_PASSWORD and
# STOCURO_DB_ROOT_PASSWORD are both set — that's intentional, so this
# never accidentally ships with an empty database password.
#
# .env itself is never committed to git (see .gitignore) — only this
# .example file is, so everyone starts from the same template without
# ever sharing real passwords through the repository.

# Host port Stocuro is reachable on, e.g. http://localhost:8080/.
# Change this if 8080 is already used by something else on this machine.
STOCURO_PORT=8080

# Database name/user Stocuro connects with. The defaults below are fine
# for almost everyone — there's rarely a reason to change these unless
# you're running more than one Stocuro instance on the same Docker host
# and need to tell their databases apart.
STOCURO_DB_NAME=stocuro
STOCURO_DB_USER=stocuro

# Required — pick your own strong passwords, don't reuse these examples.
# A long, random string is simplest, e.g. generate one with:
#   openssl rand -base64 24
STOCURO_DB_PASSWORD=change-me-db-password
STOCURO_DB_ROOT_PASSWORD=change-me-root-password
